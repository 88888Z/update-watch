#!/bin/bash
set -uo pipefail
bus="/run/user/$(id -u)/bus"
[ -S "$bus" ] || exit 0
export DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" XDG_RUNTIME_DIR="/run/user/$(id -u)"
pkcon refresh >/dev/null 2>&1 || true
sleep 3
list=$(apt list --upgradable 2>/dev/null | tail -n +2)
count=$(grep -c . <<<"$list") || count=0
epoch=$(date +%s)
top_all=$(awk -F/ '{print $1}' <<<"$list" | paste -sd', ')
printf 'checked_epoch=%s\ncount=%s\ntop=%s\n' "$epoch" "${count:-0}" "${top_all:-}" > "$HOME/.local/share/apt-watch-state"
[ "${count:-0}" -gt 0 ] || exit 0
top5=$(awk -F/ '{print $1}' <<<"$list" | head -3 | paste -sd', ')
notify-send -a "Update checker" -i software-update-available \
  "Updates pending your confirmation: $count" \
  "Open GNOME Software to review and install (e.g. ${top5}). Nothing downloads or installs without your click."
echo "$count updates pending: $top5" >> ~/.local/share/apt-watch.log 2>/dev/null || true
